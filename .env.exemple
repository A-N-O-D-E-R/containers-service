EMAIL=you@anode.com
DNS_PROVIDER=cloudflare
CF_DNS_API_TOKEN=your_token_here
JWT_SECRET=super-secret-change-me

ADMIN_DB_PASSWORD=super-secret-change-me
ADMIN_NOSQL_PASSWORD=super-secret-change-me

ZABBIX_DB_NAME=zabbix
ZABBIX_DB_USER=zabbix
ZABBIX_DB_PASSWORD=super-secret-change-me

FORGEJO_DB_NAME=forgejo
FORGEJO_DB_USER=forgejo
FORGEJO_DB_PASSWORD=super-secret-change-me

RSS_DB_NAME=rss
RSS_DB_USER=rssUNIFI_DB_PASSWORD
RSS_DB_PASSWORD=super-secret-change-me

UNIFI_DB_NAME=unifi
UNIFI_DB_USER=unifi
UNIFI_DB_PASSWORD=super-secret-change-me

CREDENTIALS="$ZABBIX_DB_NAME:$ZABBIX_DB_USER:$ZABBIX_DB_PASSWORD,$FORGEJO_DB_NAME:$FORGEJO_DB_USER:$FORGEJO_DB_PASSWORD,$RSS_DB_NAME:$RSS_DB_USER:$RSS_DB_PASSWORD"
NOSQL_CREDENTIALS="${UNIFI_DB_NAME}:${UNIFI_DB_USER}:${UNIFI_DB_PASSWORD}"
ENCRYPTION_KEY=change-me-run-openssl-rand-hex-32
GARAGE_RPC_SECRET=$(echo -n "your input string" | sha256sum | awk '{print $1}')
GARAGE_BUCKETS=bucket1,bucket2,bucket3

TMP_S3_CREDENTIALS_FILE=/tmp/credentials

# MOUNTING POINT
CERTS_DIR=./certs
LOG_DIR=./.logs
BACKUP_DIR=./.backup
S3_DATA_DIR=${BACKUP_DIR}/s3/data

BACKUP_BUCKET=bucket1 # This bucket will be backup to b2 (default-name backup-bucket)
S3_MOUNT_DIR=/mnt/backup-s3


PUID=1000
PGID=1000
TZ=Europe/Paris

NoteAuthCode=0000